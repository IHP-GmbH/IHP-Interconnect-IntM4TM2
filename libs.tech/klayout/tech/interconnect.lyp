<?xml version="1.0" encoding="utf-8"?>
<!--
  interconnect.lyp: KLayout layer properties for the post-passivation 3D
  interconnect bodies. These layers live in the interconnect PDK, not the
  interposer. Load this ALONGSIDE the interposer's intm4tm2.lyp when
  visualising an assembled stack.

  Layer numbers 500+ avoid collision with IHP SG13G2 upstream (<200).
  Datatype convention: 35 = pillar, 36 = sbump.
-->
<layer-properties>
 <properties>
  <frame-color>#b87333</frame-color>
  <fill-color>#b87333</fill-color>
  <frame-brightness>0</frame-brightness>
  <fill-brightness>0</fill-brightness>
  <dither-pattern>C5</dither-pattern>
  <line-style/>
  <valid>true</valid>
  <visible>true</visible>
  <transparent>false</transparent>
  <width>1</width>
  <marked>false</marked>
  <animation>0</animation>
  <name>CuPillar.pillar - 3D aux (Cu body)</name>
  <source>500/35@1</source>
 </properties>
 <properties>
  <frame-color>#c0c0c0</frame-color>
  <fill-color>#c0c0c0</fill-color>
  <frame-brightness>0</frame-brightness>
  <fill-brightness>0</fill-brightness>
  <dither-pattern>C5</dither-pattern>
  <line-style/>
  <valid>true</valid>
  <visible>true</visible>
  <transparent>false</transparent>
  <width>1</width>
  <marked>false</marked>
  <animation>0</animation>
  <name>SnAgCap.pillar - 3D aux (solder cap)</name>
  <source>501/35@1</source>
 </properties>
 <properties>
  <frame-color>#808080</frame-color>
  <fill-color>#808080</fill-color>
  <frame-brightness>0</frame-brightness>
  <fill-brightness>0</fill-brightness>
  <dither-pattern>C5</dither-pattern>
  <line-style/>
  <valid>true</valid>
  <visible>true</visible>
  <transparent>false</transparent>
  <width>1</width>
  <marked>false</marked>
  <animation>0</animation>
  <name>SolderBall.sbump - 3D aux (SAC305 ball)</name>
  <source>502/36@1</source>
 </properties>
 <properties>
  <frame-color>#cd7f32</frame-color>
  <fill-color>#cd7f32</fill-color>
  <frame-brightness>0</frame-brightness>
  <fill-brightness>0</fill-brightness>
  <dither-pattern>C5</dither-pattern>
  <line-style/>
  <valid>true</valid>
  <visible>true</visible>
  <transparent>false</transparent>
  <width>1</width>
  <marked>false</marked>
  <animation>0</animation>
  <name>VendorXBumpCu - 3D aux (demo, non-IHP)</name>
  <source>510/35@1</source>
 </properties>
 <properties>
  <frame-color>#d4d4d4</frame-color>
  <fill-color>#d4d4d4</fill-color>
  <frame-brightness>0</frame-brightness>
  <fill-brightness>0</fill-brightness>
  <dither-pattern>C5</dither-pattern>
  <line-style/>
  <valid>true</valid>
  <visible>true</visible>
  <transparent>false</transparent>
  <width>1</width>
  <marked>false</marked>
  <animation>0</animation>
  <name>VendorXBumpCap - 3D aux (demo, non-IHP)</name>
  <source>511/35@1</source>
 </properties>
</layer-properties>
